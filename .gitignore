# ====================
/mobile_app/.dart_tool/
/mobile_app/.idea/
/mobile_app/.vscode/
/mobile_app/build/
/mobile_app/.packages
/mobile_app/.flutter-plugins
/mobile_app/.flutter-plugins-dependencies
/mobile_app/.metadata
/mobile_app/pubspec.lock
/mobile_app/coverage/

/mobile_app/doc/api/
/mobile_app/ios/Flutter/.last_build_id
/mobile_app/.pub-cache/
/mobile_app/.pub/
/mobile_app/android/app/debug/
/mobile_app/android/app/profile/
/mobile_app/android/app/release/
/mobile_app/migrate_working_dir/

/mobile_app/app.*.symbols
/mobile_app/app.*.map.json

